+    def preprocess_images_for_parser(
+        images_unmasked_nvhwc,
+        masks_unmasked_nvhwc,
+        parser_target_hw,
+        bg_color_str="white",
+    ):
+        num_views = images_unmasked_nvhwc.shape[0]
+        target_h, target_w = parser_target_hw  # e.g., 512, 512
+
+        processed_parser_images_list = []
+        transform_params_list = []  # To store info for restoration
+
+        bg_val = 255 if bg_color_str == "white" else 0
+
+        for nv in range(num_views):
+            img_fullres = images_unmasked_nvhwc[nv]
+            mask_fullres = masks_unmasked_nvhwc[nv]
+            original_hw = img_fullres.shape[:2]
+
+            bbox = AvatarrexDatasetUtils._find_bbox(mask_fullres)
+            current_transform_params = {
+                "original_hw": original_hw,
+                "bbox": None,
+                "cropped_hw": original_hw,
+                "square_padded_side": max(original_hw),
+                "final_parser_hw": parser_target_hw,
+            }
+
+            if bbox:
+                x_min, y_min, x_max, y_max = bbox
+                img_cropped = img_fullres[y_min:y_max, x_min:x_max]
+                mask_cropped = mask_fullres[y_min:y_max, x_min:x_max]
+                current_transform_params["bbox"] = bbox
+                current_transform_params["cropped_hw"] = img_cropped.shape[:2]
+
+                img_filled_bg = AvatarrexDatasetUtils.fill_bg(
+                    img_cropped, mask_cropped, bg_color_str
+                )
+
+                img_square_padded = AvatarrexDatasetUtils._pad_to_square(
+                    img_filled_bg, (bg_val, bg_val, bg_val)
+                )
+                current_transform_params["square_padded_side"] = (
+                    img_square_padded.shape[0]
+                )
+
+                # Resize to parser input size
+                img_parser_input = cv.resize(
+                    img_square_padded,
+                    (target_w, target_h),
+                    interpolation=cv.INTER_LINEAR,
+                )
+            else:  # No bbox, create a blank image for parser
+                img_parser_input = np.full(
+                    (target_h, target_w, img_fullres.shape[-1]),
+                    bg_val,
+                    dtype=img_fullres.dtype,
+                )
+                # bbox is None, cropped_hw is original_hw, square_padded_side is max(original_hw)
+
+            processed_parser_images_list.append(img_parser_input)
+            transform_params_list.append(current_transform_params)
+
+        return np.stack(processed_parser_images_list, axis=0), transform_params_list
+
+    @staticmethod
+    def _restore_parser_output(
+        parser_output_img_512, transform_params, target_output_hw
+    ):
+        # parser_output_img_512 is (512, 512, C)
+        # transform_params: {'original_hw', 'bbox', 'cropped_hw', 'square_padded_side', 'final_parser_hw'}
+        # target_output_hw: e.g., (750, 1024) - the 1/2 original resolution
+
+        h_parser, w_parser = transform_params["final_parser_hw"]
+        h_square_padded = transform_params["square_padded_side"]
+        h_cropped, w_cropped = transform_params["cropped_hw"]
+        h_orig, w_orig = transform_params["original_hw"]  # Full resolution original
+        bbox = transform_params["bbox"]
+
+        # 1. Resize 512x512 parser output back to its "square_padded" size
+        img_resized_to_square_padded = cv.resize(
+            parser_output_img_512,
+            (h_square_padded, h_square_padded),
+            interpolation=cv.INTER_NEAREST,
+        )  # Use nearest for labels
+
+        # 2. Unpad: Remove padding to get back to "cropped_filled_bg" dimensions
+        # Calculate padding amounts that were added
+        top_pad_sq = (h_square_padded - h_cropped) // 2
+        left_pad_sq = (h_square_padded - w_cropped) // 2
+        img_unpadded_to_cropped = img_resized_to_square_padded[
+            top_pad_sq : top_pad_sq + h_cropped, left_pad_sq : left_pad_sq + w_cropped
+        ]
+
+        # 3. Create a canvas of target_output_hw (e.g., 750x1024)
+        # Determine background color (assuming parser output uses distinct label colors, bg might be a specific one)
+        # For simplicity, let's assume parser output background is 0 or needs to be set.
+        # Or, it has its own background. Let's use a common BG color (e.g., black if labels are non-zero).
+        # If parser outputs labels 0-N, background could be 0.
+        # Let's assume background for restored image should be black (0) for labels.
+        # If it's color image, needs careful bg handling.
+        # For parser label images, background is often 0 or a specific index.
+        # Let's make it flexible, or assume a black background for restored labels.
+
+        # If img_unpadded_to_cropped is label (single channel), bg_val_restore should be scalar.
+        # If it's color image, (0,0,0). Let's assume it's a color image (parser output viz)
+        bg_val_restore_rgb = (0, 0, 0)
+        restored_canvas = np.full(
+            (target_output_hw[0], target_output_hw[1], parser_output_img_512.shape[-1]),
+            bg_val_restore_rgb,
+            dtype=parser_output_img_512.dtype,
+        )
+
+        if bbox:
+            x_min_orig, y_min_orig, x_max_orig, y_max_orig = bbox
+
+            # Scale bbox coordinates to target_output_hw dimensions
+            scale_h = target_output_hw[0] / h_orig
+            scale_w = target_output_hw[1] / w_orig
+
+            x_min_target = int(x_min_orig * scale_w)
+            y_min_target = int(y_min_orig * scale_h)
+            # x_max_target = int(x_max_orig * scale_w) # Not needed directly for placement
+            # y_max_target = int(y_max_orig * scale_h)
+
+            # Resize img_unpadded_to_cropped to its size within the target_output_hw canvas
+            # Its size in original full-res was (h_cropped, w_cropped)
+            # Its size in target_output_hw will be (h_cropped * scale_h, w_cropped * scale_w)
+            target_h_cropped_on_canvas = int(h_cropped * scale_h)
+            target_w_cropped_on_canvas = int(w_cropped * scale_w)
+
+            if target_h_cropped_on_canvas > 0 and target_w_cropped_on_canvas > 0:
+                img_resized_for_canvas = cv.resize(
+                    img_unpadded_to_cropped,
+                    (target_w_cropped_on_canvas, target_h_cropped_on_canvas),
+                    interpolation=cv.INTER_NEAREST,
+                )
+
+                # Place it onto the canvas
+                # Calculate end coordinates, ensuring they don't exceed canvas bounds
+                y_end_target = min(
+                    y_min_target + target_h_cropped_on_canvas, target_output_hw[0]
+                )
+                x_end_target = min(
+                    x_min_target + target_w_cropped_on_canvas, target_output_hw[1]
+                )
+
+                # Adjust img_resized_for_canvas if placement exceeds bounds
+                img_to_place = img_resized_for_canvas[
+                    : y_end_target - y_min_target, : x_end_target - x_min_target
+                ]
+
+                restored_canvas[
+                    y_min_target:y_end_target, x_min_target:x_end_target
+                ] = img_to_place
+        else:  # No bbox, the original image was blank, so restored canvas is blank (already initialized)
+            pass
+
+        return restored_canvas
+
+    @staticmethod
+    def preprocess_images_for_flow_sam(
+        images_unmasked_nvhwc,
+        masks_unmasked_nvhwc,
+        target_output_hw,
+        bg_color_str="white",
+    ):
+        num_views = images_unmasked_nvhwc.shape[0]
+        target_h, target_w = target_output_hw  # e.g., 750, 1024
+
+        processed_flow_sam_images_list = []
+        processed_flow_sam_masks_list = []
+
+        for nv in range(num_views):
+            img_fullres = images_unmasked_nvhwc[nv]
+            mask_fullres = masks_unmasked_nvhwc[nv]
+
+            # Resize image and mask to target_output_hw
+            img_resized = cv.resize(
+                img_fullres, (target_w, target_h), interpolation=cv.INTER_LINEAR
+            )
+            mask_resized = cv.resize(
+                mask_fullres, (target_w, target_h), interpolation=cv.INTER_NEAREST
+            )
+            if mask_resized.ndim == 2:
+                mask_resized = mask_resized[..., np.newaxis]
+
+            # Fill background on the resized image using the resized mask
+            img_filled = AvatarrexDatasetUtils.fill_bg(
+                img_resized, mask_resized, bg_color_str
+            )
+
+            processed_flow_sam_images_list.append(img_filled)
+            processed_flow_sam_masks_list.append(mask_resized)
+
+        return np.stack(processed_flow_sam_images_list, axis=0), np.stack(
+            processed_flow_sam_masks_list, axis=0
+        )
+
+    # render, parser, optical, segment subj_outfit_seq meshes
+    def render_parser_optical_segment_subj_outfit_seq_meshes(
+        self, subj="", outfit="", seq="", save=False, update=False, n_start=0, num=-1, first_frame=0
+    ):
+        hyper_params = self.load_hyper_params(subj=subj, outfit=outfit, seq=seq)
+        os.makedirs(hyper_params["render_dir"], exist_ok=True)
+        os.makedirs(hyper_params["parser_dir"], exist_ok=True)
+        os.makedirs(hyper_params["optical_dir"], exist_ok=True)
+        os.makedirs(hyper_params["segment_dir"], exist_ok=True)
+        os.makedirs(hyper_params["manual_dir"], exist_ok=True)
+
+        scan_nums, scan_frames = (
+            len(hyper_params["scan_frames"]),
+            hyper_params["scan_frames"],
+        )
+        camera_ids = hyper_params["camera_ids"]
+        subj_dir = hyper_params["subj_outfit_seq_dir"]
+        render_views = hyper_params["render_views"]  # Number of views
+
+        parser_target_hw = hyper_params[
+            "parser_input_hw"
+        ]  # e.g. (512,512) - For parser model
+        flow_sam_target_hw = hyper_params[
+            "render_sizes"
+        ]  # e.g. (750,1024) - For Flow, SAM, and general output
+
+        # Caches for images/masks at flow_sam_target_hw
+        images_flow_sam_cache = {}
+        masks_flow_sam_cache = {}
+
+        start_idx = n_start
+        actual_stop_idx = scan_nums if num == -1 else n_start + num
+        stop_idx = min(actual_stop_idx, scan_nums)
+        loop = tqdm(range(start_idx, stop_idx))
+
+        enable_sam3_hands = bool(getattr(self.dataset_args, "enable_sam3_hands", False)) and (outfit == "Extended")
+
+        for n_frame_idx in loop:
+            frame = scan_frames[n_frame_idx]
+            previous_frame = scan_frames[max(first_frame, n_frame_idx - 1)]
+            loop.set_description(
+                f"## Processing Frame {frame} ({n_frame_idx+1}/{scan_nums})"
+            )
+
+            # Define save paths
+            # render_dir will store packed images/masks at flow_sam_target_hw
+            save_render_image_fn = os.path.join(
+                hyper_params["render_dir"], f"render-f{frame}.png"
+            )
+            save_render_mask_fn = os.path.join(
+                hyper_params["render_dir"], f"mask-f{frame}.png"
+            )
+            # parser_dir will store packed RESTORED parser outputs (at flow_sam_target_hw)
+            save_parser_image_fn = os.path.join(
+                hyper_params["parser_dir"], f"parser-f{frame}.png"
+            )
+            save_optical_flow_fn = os.path.join(
+                hyper_params["optical_dir"], f"optical-f{frame}.npz"
+            )
+            save_optical_vis_fn = save_optical_flow_fn.replace(".npz", ".png")
+            save_segment_mask_fn = os.path.join(
+                hyper_params["segment_dir"], f"mask-f{frame}.json"
+            )  # SAM raw output
+
+            # Declare variables for images at different stages
+            images_for_parser = None  # (NV, 512, 512, C)
+            parser_transform_params = None  # List of dicts for restoration
+
+            images_for_flow_sam = None  # (NV, H_half, W_half, C) e.g. 750x1024
+            masks_for_flow_sam = None  # (NV, H_half, W_half, 1)
+
+            run_image_loading_and_preprocessing = True
+            if (
+                not update
+                and os.path.exists(save_parser_image_fn)
+                and os.path.exists(save_optical_flow_fn)
+                and os.path.exists(save_render_image_fn)
+                and os.path.exists(save_render_mask_fn)
+            ):
+                print(
+                    f"Skipping image loading and 2D processing for frame {frame}, final files exist."
+                )
+                run_image_loading_and_preprocessing = False
+
+            if run_image_loading_and_preprocessing:
+                images_unmasked_fullres, masks_unmasked_fullres = (
+                    self.load_frame_data_static(
+                        frame, camera_ids, subj_dir, hyper_params
+                    )
+                )
+                if images_unmasked_fullres is None:
+                    print(f"Error: Missing raw frame data for {frame}.")
+                    continue
+
+                # 1. Preprocess for Parser (512x512 square input)
+                images_for_parser, parser_transform_params = (
+                    self.preprocess_images_for_parser(
+                        images_unmasked_fullres,
+                        masks_unmasked_fullres,
+                        parser_target_hw,
+                        "white",
+                    )
+                )
+
+                # 2. Preprocess for Optical Flow and SAM (e.g., 750x1024 rectangular)
+                images_for_flow_sam, masks_for_flow_sam = (
+                    self.preprocess_images_for_flow_sam(
+                        images_unmasked_fullres,
+                        masks_unmasked_fullres,
+                        flow_sam_target_hw,
+                        "white",
+                    )
+                )
+                # Cache these, as they are the "mainline" images for several steps and saving
+                images_flow_sam_cache[frame] = copy.deepcopy(images_for_flow_sam)
+                masks_flow_sam_cache[frame] = copy.deepcopy(masks_for_flow_sam)
+
+                # --- Parser (runs on images_for_parser) ---
+                parser_output_512, _ = self.parser.parser_images(images_for_parser)
+
+                # Restore parser output to flow_sam_target_hw for consistent saving/visualization
+                restored_parser_images_list = []
+                for nv_idx in range(parser_output_512.shape[0]):
+                    restored_img = self._restore_parser_output(
+                        parser_output_512[nv_idx],
+                        parser_transform_params[nv_idx],
+                        flow_sam_target_hw,
+                    )
+                    restored_parser_images_list.append(restored_img)
+                restored_parser_output_for_save = np.stack(
+                    restored_parser_images_list, axis=0
+                )  # (NV, H_half, W_half, C)
+
+                packed_restored_parser_output = self.pack_multi_view_images_static(
+                    restored_parser_output_for_save, render_views
+                )
+
+                # --- Optical Flow (runs on images_for_flow_sam) ---
+                prev_images_for_flow_sam = None
+                if previous_frame in images_flow_sam_cache:
+                    prev_images_for_flow_sam = images_flow_sam_cache[previous_frame]
+                elif n_frame_idx > 0:
+                    prev_fullres_img, prev_fullres_mask = self.load_frame_data_static(
+                        previous_frame, camera_ids, subj_dir, hyper_params
+                    )
+                    if prev_fullres_img is not None:
+                        prev_images_for_flow_sam, _ = (
+                            self.preprocess_images_for_flow_sam(
+                                prev_fullres_img,
+                                prev_fullres_mask,
+                                flow_sam_target_hw,
+                                "white",
+                            )
+                        )
+                        images_flow_sam_cache[previous_frame] = (
+                            prev_images_for_flow_sam  # Cache it
+                        )
+                else:  # First frame
+                    prev_images_for_flow_sam = images_for_flow_sam
+
+                if prev_images_for_flow_sam is not None:
+                    optical_flows_raw = (
+                        self.optical.process_images_pairs(
+                            prev_images_for_flow_sam, images_for_flow_sam
+                        )
+                        .cpu()
+                        .numpy()
+                    )
+                    optical_images_vis = self.optical.draw_sampled_flows(
+                        prev_images_for_flow_sam, optical_flows_raw
+                    )
+                    packed_optical_vis = self.pack_multi_view_images_static(
+                        optical_images_vis, render_views
+                    )
+
+                    if save:
+                        # Save packed images_for_flow_sam and masks_for_flow_sam as the "render" output first
+                        packed_render_images = self.pack_multi_view_images_static(
+                            images_for_flow_sam, render_views
+                        )
+                        packed_render_masks = self.pack_multi_view_images_static(
+                            masks_for_flow_sam, render_views
+                        )
+                        if packed_render_images is not None:
+                            save_image(save_render_image_fn, packed_render_images)
+                        if packed_render_masks is not None:
+                            save_image(
+                                save_render_mask_fn, packed_render_masks.squeeze(-1)
+                            )
+
+                        # Save parser image (then optionally overwrite it with SAM3-hands augmentation)
+                        if packed_restored_parser_output is not None:
+                            save_image(save_parser_image_fn, packed_restored_parser_output)
+                            if enable_sam3_hands:
+                                self._run_sam3_hands_augment_parser_subprocess(
+                                    sam3_project=str(getattr(self.dataset_args, "sam3_project", "")),
+                                    render_grid_path=save_render_image_fn,
+                                    parser_grid_path=save_parser_image_fn,
+                                    num_views=render_views,
+                                )
+
+                        # Save optical flow last
+                        self.optical.save_optical_flows(
+                            save_optical_flow_fn, optical_flows_raw
+                        )
+                        if packed_optical_vis is not None:
+                            save_image(save_optical_vis_fn, packed_optical_vis)
+                else:
+                    print(
+                        f"Skipping optical flow for {frame} due to missing previous processed images for flow/SAM."
+                    )
+
+                if not save:
+                    show_image(
+                        images_for_parser[0],
+                        name=f"ParserInput-{frame}-View0 ({parser_target_hw})",
+                    )
+                    show_image(
+                        restored_parser_output_for_save[0],
+                        name=f"ParserOutputRestored-{frame}-View0 ({flow_sam_target_hw})",
+                    )
+                    if images_for_flow_sam is not None:
+                        show_image(
+                            images_for_flow_sam[0],
+                            name=f"FlowSAMInput-{frame}-View0 ({flow_sam_target_hw})",
+                        )
+                    if masks_for_flow_sam is not None:
+                        show_image(
+                            masks_for_flow_sam[0],
+                            name=f"FlowSAMMask-{frame}-View0 ({flow_sam_target_hw})",
+                        )
+
+            # --- SAM Segmentation (runs on images_for_flow_sam) ---
+            run_sam_segmentation = not hyper_params.get("disable_sam_inference", False)
+            if not update and os.path.exists(save_segment_mask_fn):
+                print(f"Skipping SAM segmentation for frame {frame}, file exists.")
+                run_sam_segmentation = False
+
+            if run_sam_segmentation:
+                # Ensure images_for_flow_sam are available (either from above or loaded/processed now)
+                if images_for_flow_sam is None:
+                    if frame in images_flow_sam_cache:
+                        images_for_flow_sam = images_flow_sam_cache[frame]
+                        # Corresponding masks should also be in cache or loaded
+                        masks_for_flow_sam = masks_flow_sam_cache.get(frame)
+                        if (
+                            masks_for_flow_sam is None
+                            and images_for_flow_sam is not None
+                        ):  # Should not happen if cached together
+                            _, masks_for_flow_sam = (
+                                self.preprocess_images_for_flow_sam(  # Re-process to get masks if absolutely needed
+                                    self.load_frame_data_static(
+                                        frame, camera_ids, subj_dir, hyper_params
+                                    )[
+                                        0
+                                    ],  # only images needed
+                                    self.load_frame_data_static(
+                                        frame, camera_ids, subj_dir, hyper_params
+                                    )[
+                                        1
+                                    ],  # only masks needed
+                                    flow_sam_target_hw,
+                                    "white",
+                                )
+                            )
+
+                    else:  # Load and process fresh for flow/SAM
+                        img_full_sam, mask_full_sam = self.load_frame_data_static(
+                            frame, camera_ids, subj_dir, hyper_params
+                        )
+                        if img_full_sam is None:
+                            print(
+                                f"Error: Cannot load images for SAM on frame {frame}."
