+
+            # pix_to_face is (n_views, H, W, faces_per_pixel)
+            # bary_coords is (n_views, H, W, faces_per_pixel, 3)
+            pix_to_faces_view = pix_to_face[
+                nv, pix_points[:, 0], pix_points[:, 1], 0
+            ]  # Closest face (K=0)
+            pix_bary_coords_view = bary_coords[
+                nv, pix_points[:, 0], pix_points[:, 1], 0, :
+            ]  # Bary for closest face
+
+            valid_hits_mask = pix_to_faces_view >= 0
+            if not torch.any(valid_hits_mask):
+                continue
+
+            pix_votes_on_mask = render_votes[nv][
+                pix_points[:, 0], pix_points[:, 1]
+            ]  # (N_pix_on_mask, n_labels)
+
+            pixel_votes_valid = pix_votes_on_mask[valid_hits_mask]
+            pixel_faces_indices = pix_to_faces_view[
+                valid_hits_mask
+            ]  # Indices into the mesh's faces tensor
+            pixel_faces_local_indices = pixel_faces_indices % num_faces_per_mesh
+            pixel_faces_verts = faces_for_indexing[
+                pixel_faces_local_indices
+            ]  # (N_hits, 3) - vertex indices
+            pixel_bary_coords_valid = pix_bary_coords_view[
+                valid_hits_mask
+            ]  # (N_hits, 3)
+
+            expanded_votes = pixel_votes_valid.unsqueeze(1).expand(-1, 3, -1)
+            expanded_bary = pixel_bary_coords_valid.unsqueeze(-1).expand(
