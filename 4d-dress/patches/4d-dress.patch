+    @staticmethod
+    def pack_multi_view_images_static(images, num_view):
+        """Pack multi-view images into a grid image.
+
+        Historical behavior assumed `num_view` is divisible by 4 and asserted.
+        After filtering views (e.g., excluding bad cameras), `images.shape[0]`
+        may not be divisible by 4. We now pad the last row with blank images
+        to keep a consistent 4-column grid.
+        """
+        if images is None or getattr(images, "shape", None) is None:
+            return None
+        if images.shape[0] == 0:
+            return None
+
+        n_cols = 4
+        n_views = int(images.shape[0])
+        n_rows = int(np.ceil(n_views / float(n_cols)))
+
+        # Pad to full grid (n_rows * n_cols)
+        n_pad = n_rows * n_cols - n_views
+        if n_pad > 0:
+            pad_shape = (n_pad,) + tuple(images.shape[1:])
+            pad_imgs = np.zeros(pad_shape, dtype=images.dtype)
+            images = np.concatenate([images, pad_imgs], axis=0)
+
+        rows = [np.concatenate(images[r * n_cols : (r + 1) * n_cols], axis=1) for r in range(n_rows)]
+        return np.concatenate(rows, axis=0)
+
+    # --- Function to load images/masks for a given frame ID ---
+    @staticmethod
+    def load_frame_data_static(current_frame_id, camera_ids, subj_dir, hyper_params):
+        loaded_images_list = []
+        loaded_masks_list = []
+
+        # No longer using hyper_params['render_sizes'] for initial resize here.
+        # Images are loaded at their disk resolution.
+        # res_scale from hyper_params is also not used here for image content.
+
+        for cam_id in camera_ids:
+            img_path = os.path.join(subj_dir, cam_id, f"{current_frame_id}.jpg")
+            mask_path = os.path.join(
+                subj_dir, cam_id, "mask", "pha", f"{current_frame_id}.jpg"
+            )
+
+            if not os.path.exists(img_path):
+                print(f"Warning: Image file not found {img_path}, skipping view.")
+                continue
+            if not os.path.exists(mask_path):
+                mask_path = mask_path.replace("jpg", "png")
+                if not os.path.exists(mask_path):
+                    print(f"Warning: Mask file not found {mask_path}, skipping view.")
+                    continue
+
+            img = cv.imread(img_path)
+            if img is None:
+                print(f"Warning: Failed to read image {img_path}, skipping view.")
+                continue
+            img = cv.cvtColor(img, cv.COLOR_BGR2RGB)
+
+            mask = cv.imread(mask_path, cv.IMREAD_GRAYSCALE)
+            if mask is None:
+                print(f"Warning: Failed to read mask {mask_path}, skipping view.")
+                continue
+
+            # Process mask: Ensure binary [0, 255] and shape (H, W, 1)
+            _, mask_binary = cv.threshold(mask, 127, 255, cv.THRESH_BINARY)
+            loaded_images_list.append(img)
+            loaded_masks_list.append(mask_binary[..., np.newaxis])
+
+        if not loaded_images_list:
+            print(f"Error: No views loaded successfully for frame {current_frame_id}")
+            return None, None
+
+        images_np = np.stack(loaded_images_list, axis=0)
+        masks_np = np.stack(loaded_masks_list, axis=0)
+        return images_np, masks_np
