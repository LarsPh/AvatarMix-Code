+                            continue
+                        images_for_flow_sam, masks_for_flow_sam = (
+                            self.preprocess_images_for_flow_sam(
+                                img_full_sam, mask_full_sam, flow_sam_target_hw, "white"
+                            )
+                        )
+                        images_flow_sam_cache[frame] = images_for_flow_sam  # Cache them
+                        masks_flow_sam_cache[frame] = masks_for_flow_sam
+
+                if images_for_flow_sam is not None:
+                    segment_masks_sam_raw = self.sam.segment_images(
+                        images_for_flow_sam
+                    )  # SAM gets images at flow_sam_target_hw
+                    if save:
+                        self.sam.save_segment_masks(
+                            save_segment_mask_fn, segment_masks_sam_raw
+                        )  # Save raw JSON
+                        print(f"Info: SAM masks (raw JSON) saved for {frame}.")
+
+                        # Save visualizations based on images_for_flow_sam
+                        segment_masks_decoded = self.sam.decode_segment_masks(
