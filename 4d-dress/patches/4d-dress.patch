+"""
+Segment portrait_donator.jpg for validation data using Graphonomy.
+
+This script processes portrait-cropped images from SwapVTON Phase 3 validation data,
+running Graphonomy segmentation directly on portrait_donator.jpg files to generate
+portrait-optimized body segmentations.
+
+Usage:
+    # Process all neck modes (auto-discovery)
+    python segment_portrait_validation_data.py \
+        --input_dir /path/to/validation_data \
+        --checkpoint_dir /path/to/graphonomy/checkpoint \
+        --device cuda:0 \
+        --skip_missing
+
+    # Process specific neck modes only
+    python segment_portrait_validation_data.py \
+        --input_dir /path/to/validation_data \
+        --checkpoint_dir /path/to/graphonomy/checkpoint \
+        --neck_modes first_swap_only donator_only
+"""
+
+import argparse
+import os
+import sys
+from pathlib import Path
+from typing import List, Dict
+
+import numpy as np
+from PIL import Image
+from loguru import logger
+from tqdm import tqdm
+
+# Add parent directory to path for imports (matching segment_swapvton_renders.py pattern)
+sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from lib.utility.parser import GraphParser
+
+
+def auto_discover_neck_modes(input_dir: Path, filter_modes: List[str] = None) -> List[Path]:
+    """
+    Auto-discover neck mode subdirectories matching pattern *_neck.
+
+    Args:
+        input_dir: Path to validation_data directory
+        filter_modes: Optional list of specific neck mode names to process
+                     (e.g., ['first_swap_only', 'donator_only'])
+                     If None, auto-discovers all *_neck directories
+
+    Returns:
+        List of sorted neck mode directories (e.g., [first_swap_neck, donator_neck, union_neck])
+
+    Raises:
+        ValueError: If filter_modes specified but none found in directory
+    """
+    # Discover all neck mode directories
+    all_neck_dirs = sorted([d for d in input_dir.iterdir() if d.is_dir() and d.name.endswith('_neck')])
+
+    # If no filter specified, return all discovered modes
+    if filter_modes is None:
+        return all_neck_dirs
+
+    # Convert filter_modes to expected directory names (add _neck suffix if needed)
+    expected_dir_names = set()
+    for mode in filter_modes:
+        if mode.endswith('_neck'):
+            expected_dir_names.add(mode)
+        else:
+            expected_dir_names.add(f"{mode}_neck")
+
+    # Filter to only include specified modes
+    filtered_dirs = [d for d in all_neck_dirs if d.name in expected_dir_names]
+
+    # Validate that all requested modes were found
+    if not filtered_dirs:
+        available = [d.name for d in all_neck_dirs]
+        raise ValueError(
+            f"None of the specified neck modes {list(filter_modes)} were found. "
+            f"Available modes: {available}"
+        )
+
+    found_names = {d.name for d in filtered_dirs}
+    missing = expected_dir_names - found_names
+    if missing:
+        logger.warning(f"Some requested modes not found: {missing}")
+
+    return filtered_dirs
+
+
+def validate_portrait_resolution(image: np.ndarray, expected_size: int = 512, tolerance: int = 10) -> bool:
+    """
+    Validate that portrait image is approximately expected resolution.
+
+    Args:
+        image: RGB image array (H, W, 3)
+        expected_size: Expected width and height (default: 512)
+        tolerance: Allowed deviation (default: 10 pixels)
+
+    Returns:
+        True if resolution is valid, False otherwise
+    """
+    h, w = image.shape[:2]
+    if abs(h - expected_size) > tolerance or abs(w - expected_size) > tolerance:
+        logger.warning(f"Portrait resolution {h}x{w} differs from expected {expected_size}x{expected_size}")
+        return False
+    return True
+
+
+def segment_portrait_validation_data(
+    input_dir: str,
+    checkpoint_dir: str,
+    device: str = "cuda:0",
+    skip_missing: bool = False,
+    neck_modes: List[str] = None
+) -> Dict[str, int]:
+    """
+    Segment portrait_donator.jpg for each neck mode using Graphonomy.
+
+    Args:
+        input_dir: Path to validation_data directory
+                   (e.g., .../head_swapped_renders/swapped_.../cam_01/validation_data/)
+        checkpoint_dir: Path to Graphonomy checkpoint directory
+        device: CUDA device (default: "cuda:0")
+        skip_missing: If True, skip missing portrait_donator.jpg (log warning)
+                     If False, raise error if portrait_donator.jpg missing
+        neck_modes: Optional list of specific neck modes to process
+                   (e.g., ['first_swap_only', 'donator_only'])
+                   If None, auto-discovers and processes all *_neck directories
+
+    Returns:
+        Dictionary with statistics: {processed: int, skipped: int, failed: int}
+    """
+    input_path = Path(input_dir)
+    if not input_path.exists():
+        raise FileNotFoundError(f"Input directory not found: {input_path}")
+
+    logger.info(f"Segmenting portrait validation data from: {input_path}")
+
+    # Initialize Graphonomy parser (matching segment_swapvton_renders.py pattern)
+    logger.info("Initializing GraphParser...")
+    logger.info(f"  Checkpoint: {checkpoint_dir}")
+    logger.info(f"  Device: {device}")
+    parser = GraphParser(
+        model_path=checkpoint_dir,
+        n_classes=20,
+        init_model=True,
+        device=device
+    )
+    logger.info("GraphParser initialized successfully")
+
+    # Auto-discover neck modes (with optional filtering)
+    if neck_modes:
+        logger.info(f"Filtering to specific neck modes: {neck_modes}")
+    else:
+        logger.info("Auto-discovering all neck modes")
+
+    discovered_modes = auto_discover_neck_modes(input_path, filter_modes=neck_modes)
+    if not discovered_modes:
+        logger.warning(f"No neck mode directories found in {input_path}")
+        return {"processed": 0, "skipped": 0, "failed": 0}
+
+    logger.info(f"Found {len(discovered_modes)} neck modes to process: {[d.name for d in discovered_modes]}")
+
+    stats = {"processed": 0, "skipped": 0, "failed": 0}
+
+    # Process each neck mode
+    for neck_mode_dir in tqdm(discovered_modes, desc="Processing neck modes"):
+        mode_name = neck_mode_dir.name
+        portrait_path = neck_mode_dir / "portrait_donator.jpg"
+
+        # Check if portrait exists
+        if not portrait_path.exists():
+            msg = f"Portrait not found for {mode_name}: {portrait_path}"
+            if skip_missing:
+                logger.warning(f"[SKIP] {msg}")
+                stats["skipped"] += 1
+                continue
+            else:
+                logger.error(f"[ERROR] {msg}")
+                stats["failed"] += 1
+                continue
+
+        try:
+            # Load image at original resolution (matching segment_swapvton_renders.py pattern)
+            image = Image.open(portrait_path).convert('RGB')
+            image_original = np.array(image)
+
+            if image_original is None or image_original.size == 0:
+                raise FileNotFoundError(f"Failed to load image: {portrait_path}")
+
+            original_height, original_width = image_original.shape[:2]
+            logger.debug(f"Loaded portrait {mode_name}: {original_width}x{original_height}")
+
+            # Validate resolution (portraits should be ~512x512)
+            if not validate_portrait_resolution(image_original):
+                logger.warning(f"Resolution validation warning for {mode_name}, proceeding anyway")
+
+            # Resize for parsing to 512x512 (for better accuracy, matching segment_swapvton_renders.py)
+            resize_to = 512
+            if resize_to and (original_width != resize_to or original_height != resize_to):
+                image_for_parsing = np.array(
+                    Image.fromarray(image_original).resize((resize_to, resize_to), Image.BILINEAR)
+                )
+                logger.debug(f"Resized input from {original_width}x{original_height} to {resize_to}x{resize_to} for parsing")
+            else:
+                image_for_parsing = image_original
+
+            # Add batch dimension: [H, W, 3] → [1, H, W, 3]
+            image_batch = np.expand_dims(image_for_parsing, axis=0)
+
+            # Run Graphonomy parser (returns TWO values: parser_images and parser_values)
+            parser_images, parser_values = parser.parser_images(image_batch)
+            logger.debug(f"Parser output shape: {parser_images.shape}")
+
+            # Extract single image from batch: [1, H, W, 3] → [H, W, 3]
+            parser_image = parser_images[0]
+
+            # Resize segmentation back to original resolution if we resized for parsing
+            # Use NEAREST interpolation to preserve class labels (matching segment_swapvton_renders.py)
+            if resize_to and (resize_to != original_width or resize_to != original_height):
+                parser_image_pil = Image.fromarray(parser_image.astype(np.uint8))
+                parser_image_pil = parser_image_pil.resize(
+                    (original_width, original_height),
+                    Image.NEAREST  # NEAREST for segmentation to preserve class labels
+                )
+                parser_image = np.array(parser_image_pil)
+                logger.debug(f"Resized segmentation back to original resolution {original_width}x{original_height}")
+
+            # Save segmentation output (now at original resolution, matching segment_swapvton_renders.py)
+            output_path = neck_mode_dir / "segmentation_body_portrait_from_portrait.png"
+            output_img = Image.fromarray(parser_image.astype(np.uint8))
+            output_img.save(str(output_path))
+
+            logger.info(f"[OK] {mode_name}: saved to {output_path.name}")
+            stats["processed"] += 1
+
+        except FileNotFoundError as e:
+            logger.error(f"[ERROR] File not found for {mode_name}: {e}")
+            stats["failed"] += 1
+            # Re-raise to fail fast on missing files (matching segment_swapvton_renders.py pattern)
+            raise
+
+        except Exception as e:
+            logger.error(f"[ERROR] Unexpected error processing {mode_name}: {e}")
+            stats["failed"] += 1
+            # Re-raise to catch unexpected errors (matching segment_swapvton_renders.py pattern)
+            raise
+
+    # Log summary (matching segment_swapvton_renders.py format)
+    logger.info("="*60)
+    logger.info("Segmentation complete for portrait validation data")
+    logger.info(f"  Total neck modes: {len(discovered_modes)}")
+    logger.info(f"  Processed: {stats['processed']}")
+    logger.info(f"  Skipped: {stats['skipped']}")
+    logger.info(f"  Errors: {stats['failed']}")
+    logger.info("="*60)
+
+    return stats
+
+
+def main():
+    """Command-line interface for portrait validation data segmentation."""
+    parser = argparse.ArgumentParser(
+        description="Segment portrait_donator.jpg for SwapVTON validation data using Graphonomy",
+        formatter_class=argparse.RawTextHelpFormatter
+    )
+
+    parser.add_argument(
+        "--input_dir",
+        type=str,
+        required=True,
+        help="Path to validation_data directory (e.g., .../cam_01/validation_data/)"
+    )
+
+    parser.add_argument(
+        "--checkpoint_dir",
+        type=str,
+        required=True,
+        help="Path to Graphonomy checkpoint directory"
+    )
+
+    parser.add_argument(
+        "--device",
+        type=str,
+        default="cuda:0",
+        help="CUDA device (default: cuda:0)"
+    )
+
+    parser.add_argument(
+        "--skip_missing",
+        action="store_true",
+        help="Skip missing portrait_donator.jpg (log warning) instead of raising error"
+    )
+
+    parser.add_argument(
+        "--neck_modes",
+        type=str,
+        nargs='+',
+        default=None,
+        help=(
+            "Optional: Specific neck modes to process (e.g., first_swap_only donator_only). "
+            "If not specified, auto-discovers and processes all *_neck directories. "
+            "Mode names can be with or without '_neck' suffix."
+        )
+    )
+
+    args = parser.parse_args()
+
+    # Configure loguru
+    logger.remove()
+    logger.add(lambda msg: print(msg, end=''), colorize=True,
+               format="<green>{time:MM-DD HH:mm:ss}</green> | <level>{level: <8}</level> | <level>{message}</level>")
+
+    # Run segmentation
+    stats = segment_portrait_validation_data(
+        input_dir=args.input_dir,
+        checkpoint_dir=args.checkpoint_dir,
+        device=args.device,
+        skip_missing=args.skip_missing,
+        neck_modes=args.neck_modes
+    )
+
+    # Exit with appropriate code
+    exit_code = 0 if stats["failed"] == 0 else 1
+    exit(exit_code)
+
+
+if __name__ == "__main__":
+    main()
