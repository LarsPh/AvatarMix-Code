+    @staticmethod
+    def _find_bbox(mask_hw):  # Expects single mask (H,W) or (H,W,1)
+        if mask_hw.ndim == 3 and mask_hw.shape[-1] == 1:
+            mask_hw = mask_hw.squeeze(-1)
+
+        rows = np.any(mask_hw, axis=1)
+        cols = np.any(mask_hw, axis=0)
+        if not np.any(rows) or not np.any(cols):
+            return None  # No foreground pixels
+
+        y_min, y_max = np.where(rows)[0][[0, -1]]
+        x_min, x_max = np.where(cols)[0][[0, -1]]
+        return x_min, y_min, x_max + 1, y_max + 1  # +1 for slicing exclusivity
+
+    @staticmethod
+    def _pad_to_square(
+        image, pad_value_rgb=(255, 255, 255)
+    ):  # Expects single image (H,W,C) or (H,W)
+        h, w = image.shape[:2]
+
+        if h == w:
+            return image
+
+        max_side = max(h, w)
+
+        top_pad = (max_side - h) // 2
+        bottom_pad = max_side - h - top_pad
+        left_pad = (max_side - w) // 2
+        right_pad = max_side - w - left_pad
+
+        if image.ndim == 3:  # Color image
+            c = image.shape[2]
+            padded_image = np.full(
+                (max_side, max_side, c), pad_value_rgb, dtype=image.dtype
+            )
+            padded_image[top_pad : top_pad + h, left_pad : left_pad + w, :] = image
+        else:  # Grayscale image
+            padded_image = np.full(
+                (max_side, max_side),
+                pad_value_rgb[0] if isinstance(pad_value_rgb, tuple) else pad_value_rgb,
+                dtype=image.dtype,
+            )
+            padded_image[top_pad : top_pad + h, left_pad : left_pad + w] = image
+
+        return padded_image
