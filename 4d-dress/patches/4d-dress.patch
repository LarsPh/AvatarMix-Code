+    @staticmethod
+    def pack_multi_view_images_static(images, num_view):
+        """Pack multi-view images into a grid image.
+
+        Note: This is a duplicate definition kept for backward compatibility
+        in this file. It must remain consistent with the earlier implementation.
+        """
+        if images is None or getattr(images, "shape", None) is None:
+            return None
+        if images.shape[0] == 0:
+            return None
+
+        n_cols = 4
+        n_views = int(images.shape[0])
+        n_rows = int(np.ceil(n_views / float(n_cols)))
+
+        # Pad to full grid (n_rows * n_cols)
+        n_pad = n_rows * n_cols - n_views
+        if n_pad > 0:
+            pad_shape = (n_pad,) + tuple(images.shape[1:])
+            pad_imgs = np.zeros(pad_shape, dtype=images.dtype)
+            images = np.concatenate([images, pad_imgs], axis=0)
+
+        rows = [np.concatenate(images[r * n_cols : (r + 1) * n_cols], axis=1) for r in range(n_rows)]
+        return np.concatenate(rows, axis=0)
+
+    # --- Function to load and UNPACK multi-view images ---
+    @staticmethod
+    def load_multi_view_images_static(filename, num_view):
+        packed_img = cv.imread(
+            filename, cv.IMREAD_UNCHANGED
+        )  # Load as is (color or grayscale)
+
+        if packed_img is None:
+            print(f"Error: Failed to load packed image {filename}")
+            return None
+
+        if num_view == 0:
+            print(f"Warning: num_view is 0 for unpacking {filename}. Returning None.")
+            return None
+        # BGR2RGB
+        if packed_img.ndim == 3 and packed_img.shape[2] == 3:
+            packed_img = cv.cvtColor(packed_img, cv.COLOR_BGR2RGB)
+        # Determine layout based on num_view and the 4-column packing strategy.
+        # Packing pads to a full grid (ceil(num_view/4) rows, 4 cols).
+        n_cols = 4
+        n_rows = int(np.ceil(num_view / float(n_cols)))
+
+        # Dimensions of each individual (unpacked) image
+        # Total height of packed_img = n_rows * individual_height
+        # Total width of packed_img = n_cols * individual_width
+        if packed_img.shape[0] % n_rows != 0:
+            print(
+                f"Error: Packed image height {packed_img.shape[0]} not divisible by n_rows {n_rows} for {filename}."
+            )
+            return None
+        if packed_img.shape[1] % n_cols != 0:
+            print(
+                f"Error: Packed image width {packed_img.shape[1]} not divisible by n_cols {n_cols} for {filename}."
+            )
+            return None
+
+        n_h = packed_img.shape[0] // n_rows
+        n_w = packed_img.shape[1] // n_cols
+
+        channels = packed_img.shape[2] if packed_img.ndim == 3 else 1
+
+        unpacked_images_list = []
+
+        current_view = 0
+        for r in range(n_rows):
+            for c in range(n_cols):
+                if current_view < num_view:  # Only unpack up to num_view images
+                    row_start, row_end = r * n_h, (r + 1) * n_h
+                    col_start, col_end = c * n_w, (c + 1) * n_w
+
+                    individual_img = packed_img[row_start:row_end, col_start:col_end]
+                    unpacked_images_list.append(individual_img)
+                    current_view += 1
+                else:
+                    break
+            if current_view >= num_view:
+                break
+
+        if not unpacked_images_list:
+            print(
+                f"Error: No images were unpacked for {filename} with num_view={num_view}"
+            )
+            return None
+
+        # Stack them into (num_view, H, W, C) or (num_view, H, W)
+        try:
+            stacked_images = np.stack(unpacked_images_list, axis=0)
+        except ValueError as e:
+            print(
+                f"Error stacking unpacked images for {filename}: {e}. Individual shapes might vary."
+            )
+            # Print shapes for debugging
+            # for i, img_s in enumerate(unpacked_images_list): print(f"Img {i} shape: {img_s.shape}")
+            return None
+
+        # Ensure channel dimension for grayscale if it was squeezed during imread or processing
+        if stacked_images.ndim == 3 and channels == 1:  # (NV, H, W) -> (NV, H, W, 1)
+            stacked_images = stacked_images[..., np.newaxis]
+
+        return stacked_images
