+            filled_images[bool_mask_expanded] = bg_color_val
+        elif filled_images.ndim == 2 and bool_mask.ndim == 2:  # Grayscale image
+            filled_images[bool_mask] = bg_color_val
+        else:
+            print(
+                f"Warning: fill_bg dimension mismatch. Image: {render_images.shape}, Mask: {render_masks.shape}"
+            )
+
+        return filled_images
