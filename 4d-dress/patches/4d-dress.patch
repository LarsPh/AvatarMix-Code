+"""
+Segment SwapVTON rendered images using Graphonomy parser.
+
+This script processes rendered images from the SwapVTON pipeline (head_aligned,
+full_body_donator, or camera-level) and generates semantic segmentation masks using
+the Graphonomy human parsing model.
+
+Usage:
+    # For first-swap renders with subdirectories
+    python segment_swapvton_renders.py \
+        --input_root_dir /path/to/swapped_dir \
+        --target_subdir head_aligned \
+        --checkpoint_dir /path/to/graphonomy/checkpoint \
+        --device cuda:0 \
+        --skip_existing
+
+    # For second-swap (restored) renders at camera level
+    python segment_swapvton_renders.py \
+        --input_root_dir /path/to/restored_dir \
+        --target_subdir "" \
+        --checkpoint_dir /path/to/graphonomy/checkpoint \
+        --device cuda:0 \
+        --skip_existing
+"""
+
+import os
+import sys
+import re
+import argparse
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+from tqdm import tqdm
+from loguru import logger
+
+# Add parent directory to path for imports
+sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from lib.utility.parser import GraphParser
+
+
+def discover_camera_directories(input_root_dir):
+    """
+    Auto-discover all camera directories matching pattern \d+_p[+-]\d+
+
+    Args:
+        input_root_dir: Root directory containing camera subdirectories
+
+    Returns:
+        List of camera directory names (e.g., ['000_p+00', '005_p+20', '220_p+00'])
+    """
+    camera_dirs = []
+    camera_pattern = re.compile(r'^\d+_p[+-]\d+$')
+
+    for item in os.listdir(input_root_dir):
+        item_path = os.path.join(input_root_dir, item)
+        if os.path.isdir(item_path) and camera_pattern.match(item):
+            camera_dirs.append(item)
+
+    # Sort camera directories for consistent processing order
+    camera_dirs.sort()
+
+    logger.info(f"Discovered {len(camera_dirs)} camera directories")
+    return camera_dirs
+
+
+def load_image_with_fallback(image_path_png, image_path_jpg, target_size=None):
+    """
+    Load image, trying PNG first, then fallback to JPG.
+
+    Args:
+        image_path_png: Path to PNG image
+        image_path_jpg: Path to JPG image
+        target_size: Optional tuple (width, height) for resizing. If None, keeps original size.
+
+    Returns:
+        numpy array [h, w, 3] in RGB format
+
+    Raises:
+        FileNotFoundError: If neither PNG nor JPG exists
+    """
+    if os.path.exists(image_path_png):
+        image = Image.open(image_path_png).convert('RGB')
+    elif os.path.exists(image_path_jpg):
+        image = Image.open(image_path_jpg).convert('RGB')
+    else:
+        raise FileNotFoundError(
+            f"Image not found at either location:\n"
+            f"  PNG: {image_path_png}\n"
+            f"  JPG: {image_path_jpg}"
+        )
+
+    # Resize if target size specified
+    if target_size is not None:
+        original_size = image.size
+        image = image.resize(target_size, Image.BILINEAR)
+        logger.debug(f"Resized image from {original_size} to {target_size}")
+
+    return np.array(image)
+
+
+def segment_swapvton_renders(
+    input_root_dir,
+    target_subdir,
+    checkpoint_dir,
+    device='cuda:0',
+    skip_existing=False,
+    output_filename='segmentation.png',
+    resize_to=512
+):
+    """
+    Segment rendered images from SwapVTON pipeline using Graphonomy.
+
+    Args:
+        input_root_dir: Path to swapped directory (e.g., .../head_swapped_renders/swapped_xxx)
+        target_subdir: Subdirectory to segment ("head_aligned", "full_body_donator", or "" for camera level)
+        checkpoint_dir: Path to Graphonomy checkpoint directory
+        device: CUDA device (default: "cuda:0")
+        skip_existing: Skip if segmentation.png already exists (default: True)
+        output_filename: Output filename (default: "segmentation.png")
+        resize_to: Target size for resizing (e.g., 512 for 512x512). If None, uses original size (default: 512)
+
+    Note:
+        When target_subdir is empty string "", segments directly at camera level (cam_id/0000.jpg).
+        Useful for second-swap (restored) renders that don't have subdirectories.
+    """
+    # Format target description for logging
+    if target_subdir:
+        subdir_desc = f"subdirectory '{target_subdir}'"
+    else:
+        subdir_desc = "camera level (no subdirectory)"
+
+    logger.info(f"Starting segmentation for {subdir_desc} in {input_root_dir}")
+    logger.info(f"Checkpoint directory: {checkpoint_dir}")
+    logger.info(f"Device: {device}")
+    logger.info(f"Skip existing: {skip_existing}")
+    if resize_to:
+        logger.info(f"Resize to: {resize_to}x{resize_to}")
+
+    # Discover all camera directories
+    camera_dirs = discover_camera_directories(input_root_dir)
+
+    if not camera_dirs:
+        logger.warning(f"No camera directories found in {input_root_dir}")
+        return
+
+    # Initialize GraphParser
+    logger.info("Initializing GraphParser...")
+    parser = GraphParser(
+        model_path=checkpoint_dir,
+        n_classes=20,
+        init_model=True,
+        device=device
+    )
+    logger.info("GraphParser initialized successfully")
+
+    # Process statistics
+    processed_count = 0
+    skipped_count = 0
+    error_count = 0
+
+    # Process each camera directory
+    # Format progress bar description based on target_subdir
+    if target_subdir:
+        progress_desc = f"Segmenting {target_subdir}"
+    else:
+        progress_desc = "Segmenting camera level"
+
+    for cam_id in tqdm(camera_dirs, desc=progress_desc):
+        try:
+            # Construct paths
+            input_dir = os.path.join(input_root_dir, cam_id, target_subdir)
+            image_path_png = os.path.join(input_dir, '0000.png')
+            image_path_jpg = os.path.join(input_dir, '0000.jpg')
+            output_path = os.path.join(input_dir, output_filename)
+
+            # Check if output already exists
+            if skip_existing and os.path.exists(output_path):
+                if target_subdir:
+                    logger.debug(f"Skipping {cam_id}/{target_subdir} - output already exists")
+                else:
+                    logger.debug(f"Skipping {cam_id} - output already exists")
+                skipped_count += 1
+                continue
+
+            # Load image at original resolution (no resizing)
+            image_original = load_image_with_fallback(image_path_png, image_path_jpg, target_size=None)
+            original_height, original_width = image_original.shape[:2]
+
+            # Resize for parsing if needed (for better accuracy)
+            if resize_to:
+                image_for_parsing = np.array(
+                    Image.fromarray(image_original).resize((resize_to, resize_to), Image.BILINEAR)
+                )
+                logger.debug(f"Resized input from {original_width}x{original_height} to {resize_to}x{resize_to} for parsing")
+            else:
+                image_for_parsing = image_original
+
+            # Add batch dimension: [h, w, 3] -> [1, h, w, 3]
+            image_batch = np.expand_dims(image_for_parsing, axis=0)
+
+            # Run parser
+            parser_images, parser_values = parser.parser_images(image_batch)
+
+            # Extract single image: [1, h, w, 3] -> [h, w, 3]
+            parser_image = parser_images[0]
+
+            # Resize segmentation back to original resolution if we resized for parsing
+            if resize_to and (resize_to != original_width or resize_to != original_height):
+                parser_image_pil = Image.fromarray(parser_image.astype(np.uint8))
+                # Use NEAREST interpolation for segmentation to preserve class labels
+                parser_image_pil = parser_image_pil.resize(
+                    (original_width, original_height),
+                    Image.NEAREST
+                )
+                parser_image = np.array(parser_image_pil)
+                logger.debug(f"Resized segmentation back to original resolution {original_width}x{original_height}")
+
+            # Save segmentation output (now at original resolution)
+            output_img = Image.fromarray(parser_image.astype(np.uint8))
+            output_img.save(output_path)
+
+            # Log success with appropriate formatting
+            if target_subdir:
+                logger.debug(f"Successfully processed {cam_id}/{target_subdir}")
+            else:
+                logger.debug(f"Successfully processed {cam_id}")
+            processed_count += 1
+
+        except FileNotFoundError as e:
+            if target_subdir:
+                logger.error(f"Error processing {cam_id}/{target_subdir}: {e}")
+            else:
+                logger.error(f"Error processing {cam_id}: {e}")
+            error_count += 1
+            raise  # Re-raise to fail fast on missing files
+
+        except Exception as e:
+            if target_subdir:
+                logger.error(f"Unexpected error processing {cam_id}/{target_subdir}: {e}")
+            else:
+                logger.error(f"Unexpected error processing {cam_id}: {e}")
+            error_count += 1
+            raise  # Re-raise to catch unexpected errors
+
+    # Log summary
+    logger.info("="*60)
+    if target_subdir:
+        logger.info(f"Segmentation complete for subdirectory '{target_subdir}'")
+    else:
+        logger.info(f"Segmentation complete for camera level")
+    logger.info(f"  Total cameras: {len(camera_dirs)}")
+    logger.info(f"  Processed: {processed_count}")
+    logger.info(f"  Skipped: {skipped_count}")
+    logger.info(f"  Errors: {error_count}")
+    logger.info("="*60)
+
+
+def main():
+    """Main entry point with argument parsing."""
+    parser = argparse.ArgumentParser(
+        description='Segment SwapVTON rendered images using Graphonomy',
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+Examples:
+  # Segment head_aligned images
+  python segment_swapvton_renders.py \\
+      --input_root_dir /path/to/swapped_0214head_on_0313body_... \\
+      --target_subdir head_aligned \\
+      --checkpoint_dir /path/to/graphonomy
+
+  # Segment full_body_donator images with custom settings
+  python segment_swapvton_renders.py \\
+      --input_root_dir /path/to/swapped_0214head_on_0313body_... \\
+      --target_subdir full_body_donator \\
+      --checkpoint_dir /path/to/graphonomy \\
+      --device cuda:1 \\
+      --output_filename custom_seg.png
+        """
+    )
+
+    parser.add_argument(
+        '--input_root_dir',
+        type=str,
+        required=True,
+        help='Path to swapped directory (e.g., .../head_swapped_renders/swapped_xxx)'
+    )
+
+    parser.add_argument(
+        '--target_subdir',
+        type=str,
+        required=True,
+        choices=['head_aligned', 'full_body_donator', '', 'head_aligned_no_sam', 'full_body_donator_no_sam'],
+        help='Subdirectory to segment (use empty string "" for camera-level segmentation)'
+    )
+
+    parser.add_argument(
+        '--checkpoint_dir',
+        type=str,
+        required=True,
+        help='Path to Graphonomy checkpoint directory'
+    )
+
+    parser.add_argument(
+        '--device',
+        type=str,
+        default='cuda:0',
+        help='CUDA device (default: cuda:0)'
+    )
+
+    parser.add_argument(
+        '--skip_existing',
+        action='store_true',
+        default=False,
+        help='Skip if segmentation output already exists (default: True)'
+    )
+
+    parser.add_argument(
+        '--output_filename',
+        type=str,
+        default='segmentation.png',
+        help='Output filename (default: segmentation.png)'
+    )
+
+    parser.add_argument(
+        '--resize_to',
+        type=int,
+        default=512,
+        help='Resize images to this size (e.g., 512 for 512x512). Use 0 or None for original size (default: 512)'
+    )
+
+    args = parser.parse_args()
+
+    # Validate paths
+    if not os.path.exists(args.input_root_dir):
+        logger.error(f"Input root directory does not exist: {args.input_root_dir}")
+        sys.exit(1)
+
+    if not os.path.exists(args.checkpoint_dir):
+        logger.error(f"Checkpoint directory does not exist: {args.checkpoint_dir}")
+        sys.exit(1)
+
+    # Run segmentation
+    resize_to = args.resize_to if args.resize_to > 0 else None
+    segment_swapvton_renders(
+        input_root_dir=args.input_root_dir,
+        target_subdir=args.target_subdir,
+        checkpoint_dir=args.checkpoint_dir,
+        device=args.device,
+        skip_existing=args.skip_existing,
+        output_filename=args.output_filename,
+        resize_to=resize_to
+    )
+
+
+if __name__ == '__main__':
+    main()
