+    @staticmethod
+    def fill_bg(render_images, render_masks, color="white"):
+        # Expects single image (H,W,C) and single mask (H,W,1)
+        filled_images = copy.deepcopy(render_images)
+        if color == "white":
+            bg_color_val = 255
+        elif color == "black":
+            bg_color_val = 0
+        else:  # Default to white
+            bg_color_val = 255
+
+        # Ensure mask is boolean for indexing
+        bool_mask = render_masks == 0  # Where mask is 0 (background)
+        if filled_images.ndim == 3 and bool_mask.ndim == 3 and bool_mask.shape[-1] == 1:
