+from __future__ import annotations
+
+import sys
+from pathlib import Path
+from typing import Iterable, Tuple
+
+import numpy as np
+from PIL import Image
+
+
+LEFT_ARM_COLOR = (51, 170, 221)
+RIGHT_ARM_COLOR = (0, 255, 255)
+
+
+def _try_import_sam3() -> None:
+
+    try:
+        import sam3  # noqa: F401
+        return
+    except Exception:
+        pass
+
+
+    here = Path(__file__).resolve()
+    for p in here.parents[:8]:
+        candidate = p / "sam3"
+        if (candidate / "sam3" / "__init__.py").exists() and (
+            candidate / "pyproject.toml"
+        ).exists():
+            sys.path.insert(0, str(candidate))
+            break
+
+
+    import sam3  # noqa: F401
+
+
+def _find_bbox_from_color(
+    mask_rgb: np.ndarray, color: Tuple[int, int, int], padding: int
+) -> Tuple[int, int, int, int] | None:
+
+    if mask_rgb.ndim != 3 or mask_rgb.shape[2] != 3:
+        raise ValueError("mask_rgb must be HxWx3")
+    target = np.array(color, dtype=np.uint8).reshape(1, 1, 3)
+    matches = np.all(mask_rgb == target, axis=2)
+    if not matches.any():
+        return None
+    ys, xs = np.where(matches)
+    y0, y1 = int(ys.min()), int(ys.max()) + 1
+    x0, x1 = int(xs.min()), int(xs.max()) + 1
+    return x0 - padding, y0 - padding, x1 + padding, y1 + padding
+
+
+def _clamp_bbox(
+    bbox: Tuple[int, int, int, int], width: int, height: int
+) -> Tuple[int, int, int, int] | None:
+    x0, y0, x1, y1 = bbox
+    x0 = max(0, x0)
+    y0 = max(0, y0)
+    x1 = min(width, x1)
+    y1 = min(height, y1)
+    if x1 <= x0 or y1 <= y0:
+        return None
+    return x0, y0, x1, y1
+
+
+def _extract_union_mask_and_max_score(
+    processor,
+    image: Image.Image,
+    prompts: Iterable[str],
+    score_threshold: float,
+) -> tuple[np.ndarray, float]:
+
+    state = processor.set_image(image)
+
+    all_masks = []
+    max_score = 0.0
+
+    for prompt in prompts:
+        state = processor.set_text_prompt(prompt=prompt, state=state)
+        masks = state.get("masks")
+        scores = state.get("scores")
+        if masks is None or scores is None:
+            continue
+        if masks.numel() == 0 or scores.numel() == 0:
+            continue
+        keep = scores > score_threshold
+        if keep.any():
+            all_masks.append(masks[keep])
+            max_score = max(max_score, float(scores[keep].max().item()))
+
+    if not all_masks:
+        return np.zeros((image.height, image.width), dtype=np.uint8), 0.0
+
+    import torch
+
+    masks_cat = torch.cat(all_masks, dim=0)
+    if masks_cat.dim() == 4 and masks_cat.shape[1] == 1:
+        masks_bool = masks_cat[:, 0] > 0.5
+    elif masks_cat.dim() == 3:
+        masks_bool = masks_cat > 0.5
+    else:
+        raise ValueError(f"Unexpected mask shape: {masks_cat.shape}")
+
+    union = torch.any(masks_bool, dim=0)
+    mask_np = union.to("cpu").numpy().astype(np.uint8) * 255
+    if mask_np.shape != (image.height, image.width):
+        mask_np = np.array(
+            Image.fromarray(mask_np, mode="L").resize(image.size, Image.NEAREST),
+            dtype=np.uint8,
+        )
+    return mask_np, max_score
+
+
+class Sam3HandsAugmenter:
+
+
+    def __init__(
+        self,
+        device: str = "cuda",
+        prompt: str = "hand",
+        accept_confidence: float = 0.8,
+        score_threshold: float = 0.3,
+        bbox_padding: int = 20,
+    ):
+        _try_import_sam3()
+        from sam3.model_builder import build_sam3_image_model
+        from sam3.model.sam3_image_processor import Sam3Processor
+
+        self.device = device
+        self.prompt = prompt
+        self.accept_confidence = float(accept_confidence)
+        self.score_threshold = float(score_threshold)
+        self.bbox_padding = int(bbox_padding)
+
+        self.model = build_sam3_image_model(device=device)
+        self.processor = Sam3Processor(self.model, device=device, confidence_threshold=score_threshold)
+
+    def predict_hand_mask_for_view(
+        self,
+        rgb_view: np.ndarray,
+        parser_view: np.ndarray,
+    ) -> tuple[np.ndarray, float]:
+
+        h, w = rgb_view.shape[:2]
+        union_mask = np.zeros((h, w), dtype=np.uint8)
+        max_conf = 0.0
+
+        for color in (LEFT_ARM_COLOR, RIGHT_ARM_COLOR):
+            bbox = _find_bbox_from_color(parser_view, color=color, padding=self.bbox_padding)
+            if bbox is None:
+                continue
+            bbox = _clamp_bbox(bbox, width=w, height=h)
+            if bbox is None:
+                continue
+            x0, y0, x1, y1 = bbox
+            crop = rgb_view[y0:y1, x0:x1]
+            crop_pil = Image.fromarray(crop, mode="RGB")
+            mask_crop, conf = _extract_union_mask_and_max_score(
+                processor=self.processor,
+                image=crop_pil,
+                prompts=[self.prompt],
+                score_threshold=self.score_threshold,
+            )
+            max_conf = max(max_conf, conf)
+            if mask_crop.any():
+                union_mask[y0:y1, x0:x1] = np.maximum(
+                    union_mask[y0:y1, x0:x1], mask_crop
+                )
+
+        return union_mask, max_conf
+
+
+def apply_hands_to_parser_image(
+    parser_image_rgb: np.ndarray,
+    hand_mask: np.ndarray,
+    hands_color_rgb: Tuple[int, int, int] = (255, 0, 255),
+) -> np.ndarray:
+
+    out = parser_image_rgb.copy()
+    out[hand_mask > 0] = np.array(hands_color_rgb, dtype=np.uint8)
+    return out
