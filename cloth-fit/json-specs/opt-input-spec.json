    },
    {
        "pointer": "/solver",
        "type": "object",
        "default": null,
        "optional": [
            "nonlinear",
            "advanced",
            "max_threads",
            "parallel_similarity_hessian",
            "similarity_hessian_mode",
            "similarity_hessian_use_dx_map",
            "similarity_hessian_reserve_triplets",
            "similarity_unique_adjacency"
        ],
        "doc": "Optimization solver parameters."
    },
    {
        "pointer": "/solver/parallel_similarity_hessian",
        "default": true,
        "type": "bool",
        "doc": "If true, assemble the SimilarityForm Hessian using maybe_parallel_for (thread-local triplets). Set false to run only this Hessian assembly serially for A/B performance testing."
    },
    {
        "pointer": "/solver/similarity_hessian_mode",
        "default": "optimized",
        "type": "string",
        "choices": ["optimized", "optimized_serial", "legacy"],
        "doc": "Similarity Hessian assembly mode. optimized: parallel + dx-map + reserve. optimized_serial: serial but uses dx-map + reserve. legacy: match original behavior closely (serial, allocate V, no reserve)."
    },
    {
        "pointer": "/solver/similarity_hessian_use_dx_map",
        "default": true,
        "type": "bool",
        "doc": "If true, avoid allocating V=unflatten(x)+V_ by using an Eigen::Map of the displacement vector (Similarity Hessian only)."
    },
    {
        "pointer": "/solver/similarity_hessian_reserve_triplets",
        "default": true,
        "type": "bool",
        "doc": "If true, reserve triplet capacity based on the internal adjacency count to reduce allocator overhead (Similarity Hessian only)."
    },
    {
        "pointer": "/solver/similarity_unique_adjacency",
        "default": false,
        "type": "bool",
        "doc": "If true, process each interior triangle-triangle adjacency once (unique undirected edges) for SimilarityForm value/gradient/Hessian, removing the internal 1/2 compensation. Can reduce similarity gradient/Hessian work by ~2× on manifold meshes."
    },
    {
        "pointer": "/solver/max_threads",
        "default": 0,
        "type": "int",
        "min": 0,
        "doc": "Maximum number of threads used; 0 is unlimited."
    },
