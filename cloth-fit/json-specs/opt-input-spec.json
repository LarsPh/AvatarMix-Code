        "pointer": "/a2/enable_surf_relax",
        "type": "bool",
        "default": false,
        "doc": "If true, apply A2-based local relaxation to the surface similarity term (SimilarityForm) during Step3 only."
    },
    {
        "pointer": "/a2/surf_k",
        "type": "float",
        "default": 0.8,
        "min": 0.0,
        "doc": "Surface similarity relaxation strength: a2_surf = clamp(1 - surf_k*shrink, surf_min, 1)."
    },
    {
        "pointer": "/a2/surf_min",
        "type": "float",
        "default": 0.7,
        "min": 0.0,
        "max": 1.0,
